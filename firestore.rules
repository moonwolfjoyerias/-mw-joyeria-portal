rules_version = '2';

// MW JOYERÍA — Reglas de seguridad de Firestore (Fase 2)
//
// Cubre SOLO lo que ya está migrado a Firestore en esta fase: el perfil
// de cada cuenta real (colección "users", usada por js/auth-service.js
// para saber el rol de quien inició sesión), el Catálogo (colección
// "productos", ver js/catalogo-firestore-sync.js), Apartados, Solicitudes
// de inscripción y Personas — Emprendedoras/Líderes (colección
// "personas", ver js/personas-firestore-sync.js). Todo lo demás (Nómina,
// Comisiones como registro propio, etc.) sigue funcionando en
// localStorage — la regla final del archivo lo deniega explícitamente
// para que nadie intente leer/escribir esas colecciones desde el
// cliente antes de que tengan su propia migración y sus propias reglas
// (ver AUDITORIA-FIREBASE.md).
//
// Despliega estas reglas desde Firebase Console → Firestore Database →
// Reglas (pega este archivo completo y publica), o con la CLI:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Perfil de quien inició sesión — solo existe si Admin (o el script
    // de siembra inicial) lo creó. Nunca contiene contraseñas: esas
    // viven únicamente en Firebase Auth.
    function miPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function miRol() {
      return estaAutenticado() ? miPerfil().rol : null;
    }

    function esInterno() {
      return miRol() in ['staff', 'encargado', 'admin'];
    }

    function esAdmin() {
      return miRol() == 'admin';
    }

    // users/{uid} — cada quien lee su propio perfil (lo necesita al
    // iniciar sesión); Admin puede leer cualquiera. Crear/editar/
    // eliminar perfiles es exclusivo de Admin (alta/baja de cuentas) —
    // nunca desde el propio cliente de la persona. Eliminar el perfil
    // es el equivalente real a "eliminar la cuenta": el registro de
    // Firebase Auth en sí no se puede borrar desde el navegador (eso
    // requiere el SDK de administración), pero sin perfil aquí,
    // js/auth-service.js ya no deja iniciar sesión con esa cuenta.
    match /users/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow create, update, delete: if estaAutenticado() && esAdmin();
    }

    // productos/{id} — Catálogo. Lectura PÚBLICA a propósito (sin
    // estaAutenticado()): colecciones.html y catalogo-publico.html son
    // páginas públicas, sin login, que necesitan mostrar el catálogo
    // real de mayoreo a cualquier visitante — ese es su propósito.
    // Igual que ya pasaba con Emprendedora/Líder (que también podían
    // leer el documento completo aunque la interfaz solo les muestre
    // precio y existencia, nunca el código interno del producto), esto
    // no agrega un riesgo nuevo: el campo "codigo" y la existencia por
    // variante ya eran técnicamente legibles por cualquier cuenta
    // autenticada desde antes — ahora también por un visitante sin
    // cuenta, con la misma limitación de que el cliente solo puede
    // ocultarlo en la interfaz, no en el documento. Solo Staff/
    // Encargado/Admin pueden crear, editar, eliminar o modificar
    // existencia.
    match /productos/{id} {
      allow read: if true;
      allow write: if esInterno();
    }

    // catalogoMeta/estado — marca si el Catálogo ya se sembró alguna vez
    // en este proyecto, para no confundir "recién conectado" con
    // "alguien borró todos los productos a propósito" (ver
    // js/catalogo-firestore-sync.js). Mismos permisos que productos —
    // lectura pública por el mismo motivo.
    match /catalogoMeta/{id} {
      allow read: if true;
      allow write: if esInterno();
    }

    // ventanasApartado/{id} — Apartados. Cualquier cuenta autenticada
    // puede leer y escribir. Idealmente Emprendedora/Líder solo debería
    // poder tocar sus propias ventanas (comparando usuarioId == su
    // propio uid), pero usuarioId guarda el id de personas-ejemplo.js
    // (ej. "persona-1234"), no el uid real de Firebase Auth que ya
    // tiene su cuenta desde esta fase — esa comparación nunca
    // coincidiría todavía (mismo motivo documentado abajo en
    // solicitudesInscripcion). Ajustar cuando Apartados también guarde
    // el uid real, no solo el id de personas.
    match /ventanasApartado/{id} {
      allow read, write: if estaAutenticado();
    }

    // apartadosMeta/{id} — igual que catalogoMeta: solo trackea si
    // Apartados ya se sembró antes en este proyecto (documento
    // "estado") y guarda el objeto completo de créditos por depósitos
    // anteriores (documento "creditos"). Mismos permisos que
    // ventanasApartado.
    match /apartadosMeta/{id} {
      allow read, write: if estaAutenticado();
    }

    // solicitudesInscripcion/{id} — migrado en una fase anterior (ver
    // js/solicitudes-modelo.js), pero sus IDs de solicitante todavía son
    // los IDs de personas-ejemplo.js, no el uid real de Firebase Auth.
    // Por eso esta regla es intencionalmente amplia (cualquier cuenta
    // autenticada puede leer y escribir) en vez de comparar
    // solicitanteId == request.auth.uid, que hoy nunca coincidiría.
    match /solicitudesInscripcion/{id} {
      allow read, write: if estaAutenticado();
    }

    // personas/{id} — Emprendedoras/Líderes (ver
    // js/personas-firestore-sync.js). Cualquier cuenta autenticada
    // puede leer (Staff/Encargado la necesitan para Apartados/Lista de
    // deseos; una persona necesita ver su propio perfil y, si es Líder,
    // el de todo su equipo para Mi equipo/Comisiones/Plan MW — calcular
    // "todo mi equipo" recorre el árbol completo, así que no se puede
    // restringir a "solo mi propio documento" sin romper esas
    // pantallas). Escribir queda limitado a Staff/Encargado/Admin
    // (mismo criterio que productos) o a la propia persona sobre SU
    // documento (edita su foto/teléfono/correo/datos bancarios desde su
    // Mi cuenta) — el id del documento es el id de personas-ejemplo.js,
    // no el uid, por eso se compara contra personaId de su perfil.
    // Restringir además qué CAMPOS puede tocar cada quien (para que una
    // persona no pueda editarse su propio rango/stats/comisiones) queda
    // pendiente, igual que ya se documentó arriba para ventanasApartado
    // y solicitudesInscripcion.
    match /personas/{id} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado() && (esInterno() || miPerfil().personaId == id);
    }

    // personasMeta/estado — igual que catalogoMeta/apartadosMeta: solo
    // trackea si Personas ya se sembró antes en este proyecto.
    match /personasMeta/{id} {
      allow read, write: if estaAutenticado();
    }

    // notificaciones/{id} — ver js/notificaciones-firestore-sync.js.
    // Necesario porque cada rol usa su propio dispositivo: sin esto, un
    // aviso (solicitud aprobada, actividad asignada, apartado vencido…)
    // nunca salía del dispositivo de quien lo generó. El filtrado por
    // destinatario (paraId/rolDestino) sigue pasando en el cliente,
    // igual que antes de Firestore — mismo criterio intencionalmente
    // amplio que ventanasApartado/solicitudesInscripcion, documentado
    // ahí mismo.
    match /notificaciones/{id} {
      allow read, write: if estaAutenticado();
    }

    match /notificacionesMeta/{id} {
      allow read, write: if estaAutenticado();
    }

    // listaDeseos/{id}, listaDeseosHistorialEstados/{id},
    // listaDeseosMeta/{id} — ver js/lista-deseos-firestore-sync.js.
    // Emprendedora/Líder ahora SÍ entra aquí (js/deseos.js, "Mi lista de
    // deseos"): puede crear sus propias solicitudes y cancelarlas, no
    // solo Staff/Encargado/Admin como antes — por eso es "cualquier
    // autenticado" en vez de esInterno(), mismo criterio ya usado en
    // ventanasApartado/solicitudesInscripcion (no se restringe todavía a
    // "solo su propio registro" por la misma razón documentada ahí:
    // columnas intermedias). solicitudesResurtido sigue exclusivo de
    // Staff/Encargado/Admin — Emprendedora/Líder nunca entra a esa parte.
    match /listaDeseos/{id} {
      allow read, write: if estaAutenticado();
    }
    match /solicitudesResurtido/{id} {
      allow read, write: if esInterno();
    }
    match /listaDeseosHistorialEstados/{id} {
      allow read, write: if estaAutenticado();
    }
    match /listaDeseosMeta/{id} {
      allow read, write: if estaAutenticado();
    }

    // actividadesCatalogoStaff/{id}, actividadesStaff/{id},
    // historialActividadesStaff/{id} — ver
    // js/actividades-staff-firestore-sync.js. Exclusivo de
    // Staff/Encargado/Admin, mismo criterio que Lista de deseos.
    match /actividadesCatalogoStaff/{id} {
      allow read, write: if esInterno();
    }
    match /actividadesStaff/{id} {
      allow read, write: if esInterno();
    }
    match /historialActividadesStaff/{id} {
      allow read, write: if esInterno();
    }
    match /actividadesStaffMeta/{id} {
      allow read, write: if esInterno();
    }

    // nominaEmpleados/{id}, nominaConceptos/{id},
    // nominaHistorialAjustes/{id}, nominaHistorialEstados/{id},
    // nominaSolicitudes/{id} y nominaMeta/{id} (incluye el documento
    // "periodos", el mapa completo de nóminas por semana) — ver
    // js/nomina-firestore-sync.js. Exclusivo de Staff/Encargado/Admin,
    // mismo criterio que Lista de deseos/Actividades del Staff. La
    // misma limitación ya documentada arriba para esas dos aplica
    // aquí: cualquier cuenta interna puede leer el salario de
    // cualquier otra (antes de Firestore, el mismo dato ya vivía sin
    // más barrera que un reingreso de contraseña en el navegador — ver
    // js/staff-mi-cuenta.js → validarAutorizacionNomina — así que esto
    // no empeora la protección que ya existía, solo la iguala).
    match /nominaEmpleados/{id} {
      allow read, write: if esInterno();
    }
    match /nominaConceptos/{id} {
      allow read, write: if esInterno();
    }
    match /nominaHistorialAjustes/{id} {
      allow read, write: if esInterno();
    }
    match /nominaHistorialEstados/{id} {
      allow read, write: if esInterno();
    }
    match /nominaSolicitudes/{id} {
      allow read, write: if esInterno();
    }
    match /nominaMeta/{id} {
      allow read, write: if esInterno();
    }

    // fotosSitio/{id} — Fotografías fijas del sitio (banners, carruseles,
    // galerías) — ver js/fotos-sitio-firestore-sync.js. Lectura PÚBLICA a
    // propósito, mismo motivo que productos/catalogoMeta: index.html,
    // colecciones.html, nosotros.html, ventajas-plan.html y contacto.html
    // son páginas públicas sin sesión que necesitan mostrar estas fotos a
    // cualquier visitante. Solo Admin puede subir/eliminar/reordenar
    // (Configuración → Fotografías del sitio vive en portal/admin/, no en
    // portal/staff/ ni portal/encargado/).
    match /fotosSitio/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // eventos/{id} — Calendario de actividades (ver
    // js/eventos-firestore-sync.js). Cualquier cuenta autenticada
    // puede leer (Emprendedora/Líder solo lo consulta desde
    // js/calendario.js); crear/editar/eliminar eventos queda en
    // Staff/Encargado/Admin, que son quienes tienen el módulo de
    // Calendario con el botón "Agregar evento" — mismo criterio que
    // Lista de deseos/Actividades del Staff.
    match /eventos/{id} {
      allow read: if estaAutenticado();
      allow write: if esInterno();
    }
    match /eventosMeta/{id} {
      allow read: if estaAutenticado();
      allow write: if esInterno();
    }

    // auditoria/{id} — Bitácora de actividad ("Actividad"): quién hizo
    // qué y cuándo. Leerla sigue siendo exclusivo de Staff/Encargado/
    // Admin (Emprendedora/Líder no tiene esta pestaña), pero CREAR un
    // registro es de cualquier autenticado — crearSolicitudListaDeseos()
    // también la llama desde "Mi lista de deseos" (Emprendedora/Líder),
    // y esa acción sí debe quedar registrada. Nunca se edita ni se borra
    // un registro ya escrito — solo se agregan documentos nuevos.
    match /auditoria/{id} {
      allow read: if esInterno();
      allow create: if estaAutenticado();
      allow update, delete: if esInterno();
    }

    // Todo lo que no esté arriba sigue en localStorage — se deniega por
    // defecto hasta que tenga su propia migración y sus propias reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
